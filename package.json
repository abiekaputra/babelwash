{
  "name": "babelwash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first laundry operations and customer order platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check:files": "node scripts/check-file-lengths.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @babelwash/api dev",
    "dev:web": "pnpm --filter @babelwash/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings apps packages tests e2e",
    "quality": "pnpm format:check && pnpm check:files && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup:local": "node scripts/setup-local.mjs",
    "test": "pnpm --filter @babelwash/domain build && vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm --filter @babelwash/domain build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.7.2",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
